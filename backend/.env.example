# --- Database: Postgres (Neon recommended, free tier) ---
# Create a free project at https://neon.tech, then copy the "Connection string" it gives you.
# It looks like: postgresql://user:pass@ep-xxxx.neon.tech/dbname?sslmode=require
# IMPORTANT: no quotes around the value, no trailing spaces, and fully restart the server
# after editing this file — it is not hot-reloaded.
DATABASE_URL=

# --- Server ---
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# --- AI: Google AI Studio (Gemini) - FREE tier ---
# Get keys at https://aistudio.google.com/app/apikey
# You can set up to THREE keys. SPYNX AI tries them in order and automatically
# falls back to the next one if a key fails or hits a rate limit. Only the first
# is required — the others are optional.
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GEMINI_MODEL=gemini-2.0-flash

# --- Email verification: Resend (free tier) ---
RESEND_API_KEY=
EMAIL_FROM=SPYNXcomerce <onboarding@resend.dev>

# --- Payments: Paystack (covers Mobile Money + Cards in Ghana/Africa) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Payments: Stripe (covers international cards) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# --- Business settings ---
COMMISSION_MOMO_NUMBER=0244000000
COMMISSION_MOMO_NAME=SPYNXcomerce Ltd
COMMISSION_PERCENT=5
BUYER_SERVICE_FEE_PERCENT=2
